# CMP Production Environment Configuration
# Copy this file to .env and fill in your actual values for production deployment

# === Application Configuration ===
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-secret-key-here-minimum-32-characters
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# === Database Configuration ===
# PostgreSQL Database (Production)
DATABASE_URL=postgresql://cmp_user:your_secure_password@db:5432/cmp_prod
DB_HOST=db
DB_PORT=5432
DB_NAME=cmp_prod
DB_USER=cmp_user
DB_PASSWORD=your_secure_password

# === Redis Configuration ===
REDIS_URL=redis://redis:6379/0

# === GitHub Integration ===
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=xidioda
GITHUB_REPO_NAME=CMP

# === N8N Workflow Integration ===
N8N_WEBHOOK_URL=http://localhost:5678/webhook
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# === Authentication Configuration ===
JWT_SECRET_KEY=your-jwt-secret-key-here-minimum-64-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Zoho Books API Configuration ===
# Get these from https://api-console.zoho.com/
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=https://your-domain.com/settings/integrations/zoho/callback
ZOHO_ORGANIZATION_ID=your_zoho_organization_id_here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_URL=https://www.zohoapis.com/books/v3

# === Bank API Configuration ===
# Emirates NBD API Souq Configuration (Real UAE Bank API)
# Apply for access at https://developer.emiratesnbd.com/
EMIRATES_NBD_API_KEY=your_emirates_nbd_api_key_here
EMIRATES_NBD_CLIENT_ID=your_emirates_nbd_client_id_here
EMIRATES_NBD_ACCOUNT_NUMBER=your_emirates_nbd_account_number_here
EMIRATES_NBD_BASE_URL=https://api.emiratesnbd.com/v1

# === WIO Bank Configuration ===
# Bank file import configuration (for banks without APIs like Wio Bank)
BANK_IMPORT_DIRECTORY=/app/local_storage/bank_statements
WIO_ACCOUNT_NUMBER=your_wio_account_number_for_identification

# === File Storage Configuration ===
UPLOAD_DIR=/app/local_storage
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.csv,.xlsx,.pdf,.png,.jpg,.jpeg

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FILE=/app/logs/cmp.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# === API Configuration ===
API_RATE_LIMIT=100
API_TIMEOUT=30

# === Email Configuration (Optional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# === AI/ML Configuration ===
OPENAI_API_KEY=your_openai_api_key
MODEL_STORAGE_PATH=/app/local_storage/ml_models

# === Security Configuration ===
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
CSRF_SECRET=your-csrf-secret-key-here
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# === Monitoring Configuration (Optional) ===
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
HEALTH_CHECK_INTERVAL=30

# === Docker Configuration ===
COMPOSE_PROJECT_NAME=cmp
POSTGRES_PASSWORD=your_secure_postgres_password
REDIS_PASSWORD=your_secure_redis_password

# === Backup Configuration ===
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# === SSL/TLS Configuration ===
SSL_CERT_PATH=/etc/ssl/certs/your-cert.pem
SSL_KEY_PATH=/etc/ssl/private/your-key.pem
SSL_REDIRECT=true

# === Rate Limiting Configuration ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# === Cache Configuration ===
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# === Worker Configuration ===
WORKER_PROCESSES=2
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30
WORKER_KEEPALIVE=2
